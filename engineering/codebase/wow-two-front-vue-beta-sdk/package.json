    "build": "vite build && cp src/index.css dist/index.css && node scripts/build-themes-css.mjs",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.typecheck.json && pnpm check:capabilities && node scripts/check-sfc.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"{src,tests}/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,vue,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm check:package",
    "check:package": "node scripts/check-package.mjs",
    "check:capabilities": "node scripts/check-capabilities.mjs --all",
    "check:sfc": "node scripts/check-sfc.mjs",
    "playground": "pnpm --filter playground dev"
