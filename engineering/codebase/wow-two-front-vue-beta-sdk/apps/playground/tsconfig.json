{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"],
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    // The gallery imports the lib through its PUBLIC subpaths, which Vite aliases
    // to source. Mirror that here so the editor resolves the same files the
    // bundler does — `dist/` may be stale or absent during a port.
    "paths": {
      "@wow-two-beta/ui-vue": ["../../src/index.ts"],
      "@wow-two-beta/ui-vue/foundation/*": ["../../src/foundation/*/index.ts"],
      "@wow-two-beta/ui-vue/domain/*": ["../../src/domain/*/index.ts"],
      "@wow-two-beta/ui-vue/presentation/*": ["../../src/presentation/*/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["node_modules", "dist"]
}
