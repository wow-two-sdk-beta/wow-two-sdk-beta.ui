{
  "name": "@wow-two-beta/ui",
  "version": "0.0.71",
  "description": "Beta-forever React UI library for the wow-two ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wow-two-sdk-beta/wow-two-sdk-beta.ui.git"
  },
  "homepage": "https://github.com/wow-two-sdk-beta/wow-two-sdk-beta.ui#readme",
  "bugs": {
    "url": "https://github.com/wow-two-sdk-beta/wow-two-sdk-beta.ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwind",
    "wow-two",
    "beta"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./foundation/utils": {
      "types": "./dist/foundation/utils/index.d.ts",
      "import": "./dist/foundation/utils/index.js",
      "default": "./dist/foundation/utils/index.js"
    },
    "./foundation/hooks": {
      "types": "./dist/foundation/hooks/index.d.ts",
      "import": "./dist/foundation/hooks/index.js",
      "default": "./dist/foundation/hooks/index.js"
    },
    "./foundation/icons": {
      "types": "./dist/foundation/icons/index.d.ts",
      "import": "./dist/foundation/icons/index.js",
      "default": "./dist/foundation/icons/index.js"
    },
    "./foundation/primitives": {
      "types": "./dist/foundation/primitives/index.d.ts",
      "import": "./dist/foundation/primitives/index.js",
      "default": "./dist/foundation/primitives/index.js"
    },
    "./foundation/themes": {
      "types": "./dist/foundation/themes/index.d.ts",
      "import": "./dist/foundation/themes/index.js",
      "default": "./dist/foundation/themes/index.js"
    },
    "./foundation/http": {
      "types": "./dist/foundation/http/index.d.ts",
      "import": "./dist/foundation/http/index.js",
      "default": "./dist/foundation/http/index.js"
    },
    "./domain/color": {
      "types": "./dist/domain/color/index.d.ts",
      "import": "./dist/domain/color/index.js",
      "default": "./dist/domain/color/index.js"
    },
    "./presentation/actions": {
      "types": "./dist/presentation/actions/index.d.ts",
      "import": "./dist/presentation/actions/index.js",
      "default": "./dist/presentation/actions/index.js"
    },
    "./presentation/display": {
      "types": "./dist/presentation/display/index.d.ts",
      "import": "./dist/presentation/display/index.js",
      "default": "./dist/presentation/display/index.js"
    },
    "./presentation/feedback": {
      "types": "./dist/presentation/feedback/index.d.ts",
      "import": "./dist/presentation/feedback/index.js",
      "default": "./dist/presentation/feedback/index.js"
    },
    "./presentation/forms": {
      "types": "./dist/presentation/forms/index.d.ts",
      "import": "./dist/presentation/forms/index.js",
      "default": "./dist/presentation/forms/index.js"
    },
    "./presentation/layout": {
      "types": "./dist/presentation/layout/index.d.ts",
      "import": "./dist/presentation/layout/index.js",
      "default": "./dist/presentation/layout/index.js"
    },
    "./presentation/nav": {
      "types": "./dist/presentation/nav/index.d.ts",
      "import": "./dist/presentation/nav/index.js",
      "default": "./dist/presentation/nav/index.js"
    },
    "./presentation/overlays": {
      "types": "./dist/presentation/overlays/index.d.ts",
      "import": "./dist/presentation/overlays/index.js",
      "default": "./dist/presentation/overlays/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./themes.css": "./dist/themes.css",
    "./themes.json": "./dist/themes.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --outDir dist && cp src/index.css dist/index.css && node scripts/build-themes-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o storybook-static",
    "playground": "pnpm --filter playground dev",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.0",
    "@js-temporal/polyfill": "^0.5.0",
    "@radix-ui/react-focus-scope": "^1.1.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "marked": "^18.0.3",
    "tailwind-merge": "^3.0.0",
    "tailwind-variants": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/react": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.14.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.3.6",
    "storybook-addon-pseudo-states": "10.3.6",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^6.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
